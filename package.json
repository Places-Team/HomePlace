{
  "name": "homeplace",
  "version": "0.1.0",
  "private": true,
  "description": "HomePlace — a self-hosted dashboard and monitoring panel for your home server.",
  "scripts": {
    "dev": "next dev -p 3200",
    "build": "prisma generate && next build",
    "start": "next start -p 3200",
    "lint": "eslint .",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "admin:reset": "node scripts/admin-reset.mjs",
    "postinstall": "prisma generate",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.21.3",
    "bcryptjs": "^2.4.3",
    "fetch-socks": "^1.3.2",
    "jose": "^5.6.3",
    "jpeg-js": "^0.4.4",
    "next": "^16.3.5",
    "nodemailer": "^9.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "undici": "^6.19.8",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.10",
    "@types/nodemailer": "^6.4.24",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "postcss": "^8.4.39",
    "prisma": "^5.18.0",
    "tailwindcss": "^3.4.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
