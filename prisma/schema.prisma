// HomePlace — data model.
//
// The database holds *what the user arranged*: accounts, dashboards, tiles,
// widget settings, and a short history of availability. It deliberately does
// NOT hold addresses of hosts or any credential — those live in .env, because
// this repository is public and a database file gets copied around.
//
// Metric history (CPU, RAM, disk over time) is not stored here either: that is
// what Prometheus is for. HomePlace keeps only its own uptime checks, which
// must work even when no Prometheus is configured.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Accounts ───────────────────────────────

model User {
  id           String   @id @default(cuid())
  // Local login name. Unique when present; absent for accounts that exist only
  // through an external identity provider.
  login        String?  @unique
  email        String?  @unique
  name         String
  // Absent for SSO-only accounts — they never have a password here.
  passwordHash String?
  // Identity from the external provider (FriendPlace), when linked.
  fpUserId     String?  @unique
  avatarUrl    String?

  // owner — the account created by the setup wizard: cannot be demoted or
  // deleted, so the panel can never lock everyone out.
  // admin  — may edit dashboards and control containers.
  // viewer — read-only.
  role     String  @default("viewer")
  disabled Boolean @default(false)

  locale String @default("en")
  // light | dark | system
  theme  String @default("system")
  accent String @default("default")

  // Bumped to invalidate every session this account has: changing a password,
  // or asking to be signed out everywhere. The number is carried in the cookie,
  // so old cookies stop matching without keeping a table of live sessions.
  tokenVersion Int @default(0)

  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?

  dashboards  Dashboard[]
  linkDevices LinkDevice[]
}

// ─────────────────────────────── Dashboards ─────────────────────────────

// A dashboard is one tab of the home page.
model Dashboard {
  id     String  @id @default(cuid())
  name   String
  // Readable identifier used in the URL (`/?tab=home`). Optional so an older
  // database keeps working; filled in on first load.
  //
  // Indexed but deliberately NOT unique. Uniqueness is arranged when the slug
  // is generated, and two dashboards briefly sharing one is a cosmetic problem
  // — the first match wins. A unique constraint, by contrast, is a schema
  // change `prisma db push` refuses to make without being told it may lose
  // data, which would stop an existing installation from starting at all.
  slug   String?
  icon   String?
  order  Int     @default(0)
  // Private dashboards are visible only to their owner; the rest are shared
  // with everyone who can log in.
  shared Boolean @default(true)

  // Atmosphere: a photo behind the tiles. This is a home page someone looks at
  // all day, and a wall of grey cards is a worse place to spend a day than the
  // same cards over a picture you like. Dim and blur keep it readable —
  // without them a busy photo makes every label harder to read.
  backgroundUrl  String?
  backgroundDim  Int     @default(55) // percent of dark overlay
  backgroundBlur Int     @default(0) // pixels

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  items     Item[]
  createdAt DateTime @default(now())

  @@index([ownerId])
  @@index([slug])
}

// Everything placed on a dashboard is an Item. One table instead of four,
// because tiles are dragged, reordered and nested as a single list — splitting
// them by kind would mean merging the lists back together on every render.
model Item {
  id          String    @id @default(cuid())
  dashboardId String
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  // Folders contain other items; parentId is null at the top level.
  parentId String?
  parent   Item?   @relation("ItemChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children Item[]  @relation("ItemChildren")

  // service | link | folder | widget
  kind String

  title    String
  subtitle String?
  // Icon: an emoji, a URL, or a built-in name. Rendered as-is when it is not a URL.
  icon     String?
  color    String?

  // Where clicking the tile takes you. `url` is what the browser opens;
  // `internalUrl` is an optional LAN address used when the public one is
  // unreachable (or for the availability check).
  url         String?
  internalUrl String?
  // Open in a new tab.
  newTab      Boolean @default(true)

  // Docker link: the container this tile represents, on the host named below.
  containerName String?
  hostKey       String?

  // Availability check: none | http | tcp | docker | ping
  checkKind     String  @default("none")
  // Overrides url/internalUrl for the check when the tile links somewhere else
  // than the health endpoint.
  checkUrl      String?
  checkInterval Int     @default(60) // seconds
  // HTTP status codes considered healthy, as "200-299,401" (empty = 200-399).
  expectStatus  String?

  // Widget kind for kind = "widget": system | disks | chart | uptime | clock |
  // search | notes | containers | proxmox. Free-form so a new widget does not
  // need a migration.
  widget String?
  // Widget settings as JSON (PromQL query, unit, thresholds, …).
  config String?

  // Grid placement on a 12-column board. x/y are the top-left cell, w/h the
  // size in cells. Gaps are allowed — the point of dragging a tile somewhere is
  // that it stays where it was put.
  //
  // `order` survives as the reading order: it decides the single-column
  // stacking on a phone, where a two-dimensional layout cannot be shown.
  order Int @default(0)
  x     Int @default(0)
  y     Int @default(0)
  w     Int @default(3)
  h     Int @default(1)
  // Pinned: cannot be dragged, and is never pushed aside to make room for a
  // tile someone else is moving. Folders in particular want this — a folder is
  // a landing place, and a landing place that wanders is useless.
  locked Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checks UptimeCheck[]
  events Event[]

  @@index([dashboardId, parentId, order])
  @@index([containerName])
}

// ──────────────────────────── Uptime & events ───────────────────────────

// One row per probe. Rows are pruned by age (see UPTIME_RETENTION_DAYS) —
// this table is a rolling window, not an archive.
model UptimeCheck {
  id     String   @id @default(cuid())
  itemId String
  item   Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  at     DateTime @default(now())
  ok     Boolean
  // Round-trip time in milliseconds; null when the probe never connected.
  latency Int?
  status  Int?
  error   String?

  @@index([itemId, at])
}

// A coarse, persisted history of what each container costs, for installations
// with no Prometheus. One row per container per minute, kept a week and pruned
// on the monitor tick — enough for a day's chart without the million-rows-a-week
// that a fifteen-second sample would be.
model MetricSample {
  id     String   @id @default(cuid())
  name   String
  at     DateTime @default(now())
  cpu    Float
  memory Float

  @@index([name, at])
}

// A scheduled action: do a thing at a time or on an interval — restart a
// container, run a Home Assistant scene, send a notification. Evaluated on the
// monitor tick, so it needs no separate scheduler process.
model Schedule {
  id      String  @id @default(cuid())
  name    String
  enabled Boolean @default(true)

  // When: "daily" (timeOfDay), "weekly" (timeOfDay + weekday), or "interval".
  kind            String
  timeOfDay       String? // "HH:MM"
  weekday         Int? // 0 (Sunday) – 6
  intervalMinutes Int?

  // What: "restart" | "scene" | "notify".
  action        String
  hostKey       String?
  containerName String?
  entityId      String?
  title         String?
  body          String?

  lastRunAt DateTime?
  createdAt DateTime  @default(now())
}

// One eaten thing in the food diary. The daily totals are summed from these and
// compared against the targets computed from the person's profile.
model FoodLog {
  id      String   @id @default(cuid())
  userId  String
  at      DateTime @default(now())
  name    String
  kcal    Float
  protein Float    @default(0)
  fat     Float    @default(0)
  carbs   Float    @default(0)
  grams   Float?

  @@index([userId, at])
}

// A change worth remembering: a service went down, came back, a container was
// restarted, someone logged in. The feed on the dashboard reads this table.
model Event {
  id     String  @id @default(cuid())
  itemId String?
  item   Item?   @relation(fields: [itemId], references: [id], onDelete: SetNull)

  // down | up | restart | login | auth-fail | discovery | system
  type     String
  // info | warn | error
  severity String @default("info")
  title    String
  detail   String?
  // Who caused it, when it was a person.
  actor    String?

  at DateTime @default(now())

  @@index([at])
  @@index([itemId, at])
}

// ───────────────────────────── Miscellaneous ────────────────────────────

// One row per tile that is being watched: what state it is in and whether the
// owner has already been told about it.
//
// Separate from UptimeCheck because it answers a different question. The check
// table says what happened at a moment; this says "is there an outstanding
// problem, and did we already send a message about it" — which is what keeps a
// service flapping every 30 seconds from producing 120 notifications an hour.
model AlertState {
  itemId String   @id
  // up | down
  state  String
  // When the current state began — the delay is measured from here.
  since  DateTime @default(now())
  // Set once a message went out for the current state; cleared on recovery.
  notifiedAt DateTime?

  updatedAt DateTime @updatedAt
}

// A condition worth being told about, beyond "is it answering".
//
// Availability is handled by the prober and needs no configuration; this is for
// the questions only the person running the server can ask — "tell me before
// the disk fills", "tell me if the CPU stays pinned". The condition is PromQL
// because that is where the numbers already live, and inventing a small query
// language on top would be a worse version of it.
model AlertRule {
  id      String  @id @default(cuid())
  name    String
  enabled Boolean @default(true)

  // Where the number comes from: "prometheus" (PromQL in `query`) or "ha" (the
  // numeric state of the Home Assistant entity in `entityId`). Same threshold,
  // hold and notify machinery either way.
  source     String  @default("prometheus")
  entityId   String?
  // PromQL returning a number. The first sample of the result is compared.
  // Ignored for an "ha" rule.
  query      String  @default("")
  // gt | lt
  comparison String  @default("gt")
  threshold  Float
  // The condition must hold this long before anything is sent — a CPU spike is
  // not an incident, ten minutes of one is.
  forSeconds Int     @default(300)
  // info | warn | error
  severity   String  @default("warn")
  // Optional unit for the message: percent | bytes | number
  unit       String  @default("number")

  // Evaluation state, kept here rather than in a second table: one rule has
  // exactly one state, and a join for it would be ceremony.
  firing     Boolean   @default(false)
  since      DateTime?
  notifiedAt DateTime?
  lastValue  Float?
  lastError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A linked Google account, for the calendar widget.
//
// Tokens are stored encrypted (lib/secretBox.ts). One row per user: a calendar
// is personal, and two people sharing a panel should not share a mailbox.
model GoogleAccount {
  userId       String   @id
  email        String
  // Encrypted at rest.
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  scope        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// A browser that asked to be notified.
//
// One row per browser, not per person: the same account on a phone and a laptop
// is two subscriptions, and each is revoked independently when its browser
// forgets the permission.
model PushSubscription {
  endpoint  String   @id
  userId    String
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// Something to be reminded of.
//
// Deliberately simple: a title, a time, and whether it repeats. A panel that is
// open all day is a good place for "take the bins out", and a bad place for a
// project management tool.
model Reminder {
  id      String   @id @default(cuid())
  userId  String
  title   String
  at      DateTime
  // none | daily | weekly | monthly
  repeat  String   @default("none")
  done    Boolean  @default(false)
  completedAt DateTime?
  // Set when the notification went out, so it is sent exactly once per due time.
  notifiedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, at])
}

// Small key/value store for panel-wide settings that are not secrets:
// default locale, whether discovery is enabled, containers the user chose to
// hide, and so on. Values are JSON.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// A native client approved for this HomePlace installation. Credentials are
// represented only by a one-way hash; the raw bearer token is returned once.
model LinkDevice {
  id              String   @id @default(cuid())
  name            String
  platform        String
  platformVersion String
  appVersion      String
  publicKey       String
  credentialHash  String   @unique
  capabilities    String
  // Server-side actions approved with the pairing request. Device
  // capabilities describe what the phone can do; permissions describe what
  // the phone may ask HomePlace to do.
  permissions     String   @default("[]")
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastSeenAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  pairings LinkPairing[]
  events   LinkDeviceEvent[]

  @@index([revokedAt, lastSeenAt])
  @@index([userId, revokedAt])
}

// Temporary, encrypted file content offered to exactly one approved device.
// Rows and files expire after five minutes and are removed after download.
model LinkFileTransfer {
  id             String   @id @default(cuid())
  sourceDeviceId String
  targetDeviceId String
  encryptedKey   String
  storageName    String   @unique
  filename       String
  mimeType       String
  size           Int
  sha256         String
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@index([targetDeviceId, expiresAt])
  @@index([expiresAt])
}

// A short-lived request waiting for approval in the web interface.
model LinkPairing {
  id                  String   @id @default(cuid())
  code                String?  @unique
  claimSecretHash     String   @unique
  status              String   @default("pending")
  name                String
  platform            String
  platformVersion     String
  appVersion          String
  publicKey           String
  capabilities        String
  permissions         String   @default("[]")
  expiresAt           DateTime
  approvedById        String?
  encryptedCredential String?
  claimedAt           DateTime?
  createdAt           DateTime @default(now())

  deviceId String?
  device   LinkDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([status, expiresAt])
}

// A bounded queue of messages for a device. The first Android slice receives
// these through authenticated heartbeats; a realtime gateway can replace the
// transport later without changing the event envelope.
model LinkDeviceEvent {
  id          String   @id @default(cuid())
  deviceId    String
  kind        String
  payload     String
  deliveredAt DateTime?
  createdAt   DateTime @default(now())

  device LinkDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, deliveredAt, createdAt])
}
